*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
venv/
VenvIA/
.venv/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

