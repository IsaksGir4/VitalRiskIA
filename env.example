# ============================================================
# VitalRisk AI — Variables de entorno
# Equipo 326 | Datos al Ecosistema 2026
# ============================================================
# INSTRUCCIONES:
# 1. Copiar este archivo: cp .env.example .env
# 2. Completar los valores según tu entorno
# 3. NUNCA versionar el archivo .env (está en .gitignore)
# ============================================================

# ── Base de datos ──────────────────────────────────────────
# Local con Docker: HOST=127.0.0.1, PORT=5433
# Supabase Session Pooler (producción Render):
#   HOST=aws-0-us-east-1.pooler.supabase.com, PORT=5432
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=vitalrisk_db

# ── Entorno ────────────────────────────────────────────────
# development | production
ENVIRONMENT=development

# ── (Opcional) API keys Socrata para mayor rate limit ──────
# Sin key: límite de 1,000 req/h por IP
# Con key: límite de 10,000 req/h
# Obtener en: https://dev.socrata.com/register
# SOCRATA_APP_TOKEN=
